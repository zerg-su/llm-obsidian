{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-obsidian.local/schemas/research-result-v2.schema.json",
  "title": "Protected research cited result v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "status", "artifact"],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "status": {"const": "complete"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "sha256", "citations"],
      "properties": {
        "kind": {"const": "cited-markdown"},
        "path": {"const": "answer.md"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["url", "title", "source_class"],
            "properties": {
              "url": {"type": "string", "format": "uri"},
              "title": {"type": "string", "minLength": 1, "maxLength": 1000},
              "source_class": {
                "enum": ["official", "internal", "third-party"]
              }
            }
          }
        }
      }
    }
  }
}
