{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-obsidian.local/schemas/outcome-contract-v1.schema.json",
  "title": "Outcome Contract v1",
  "type": "object",
  "additionalProperties": false,
  "minProperties": 4,
  "maxProperties": 5,
  "required": ["schema_version", "desired_outcome", "success_evidence", "non_goals"],
  "properties": {
    "schema_version": {"const": 1},
    "purpose": {"type": "string", "minLength": 1, "maxLength": 2000},
    "desired_outcome": {"type": "string", "minLength": 1, "maxLength": 4000},
    "success_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "observable"],
        "properties": {
          "evidence_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "observable": {"type": "string", "minLength": 1, "maxLength": 2000}
        }
      }
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    }
  }
}
