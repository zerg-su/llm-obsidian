{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-obsidian.local/schemas/review-v1.schema.json",
  "title": "Harness review v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "run_id",
    "mode",
    "head_sha",
    "verification_profile",
    "verdict",
    "axes",
    "verification_gaps",
    "notes_for_executor",
    "residual_risks"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "operation_id": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "run_id": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "mode": {"enum": ["deep", "full", "simple"]},
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "verification_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256"],
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "verdict": {"enum": ["approve", "changes-requested", "blocked"]},
    "axes": {
      "type": "array",
      "items": {"$ref": "#/$defs/axis"}
    },
    "verification_gaps": {"$ref": "#/$defs/boundedStrings"},
    "notes_for_executor": {"$ref": "#/$defs/boundedStrings"},
    "residual_risks": {"$ref": "#/$defs/boundedStrings"}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "simple"}}},
      "then": {
        "properties": {
          "axes": {
            "minItems": 1,
            "maxItems": 1,
            "prefixItems": [
              {
                "allOf": [
                  {"$ref": "#/$defs/axis"},
                  {
                    "properties": {
                      "axis": {"pattern": "^(anthropic|openai)-holistic$"},
                      "verification_iteration": {"maximum": 1}
                    }
                  }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "deep"}}},
      "then": {
        "properties": {
          "axes": {
            "minItems": 2,
            "maxItems": 2,
            "oneOf": [
              {
                "prefixItems": [
                  {"properties": {"axis": {"const": "anthropic-holistic"}}},
                  {"properties": {"axis": {"const": "openai-holistic"}}}
                ]
              },
              {
                "prefixItems": [
                  {"properties": {"axis": {"const": "anthropic-intent"}}},
                  {"properties": {"axis": {"const": "anthropic-engineering"}}}
                ]
              },
              {
                "prefixItems": [
                  {"properties": {"axis": {"const": "openai-intent"}}},
                  {"properties": {"axis": {"const": "openai-engineering"}}}
                ]
              }
            ],
            "items": {
              "allOf": [
                {"$ref": "#/$defs/axis"},
                {"properties": {"verification_iteration": {"maximum": 2}}}
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "full"}}},
      "then": {
        "properties": {
          "axes": {
            "minItems": 4,
            "maxItems": 4,
            "prefixItems": [
              {"properties": {"axis": {"const": "anthropic-intent"}}},
              {"properties": {"axis": {"const": "anthropic-engineering"}}},
              {"properties": {"axis": {"const": "openai-intent"}}},
              {"properties": {"axis": {"const": "openai-engineering"}}}
            ],
            "items": {
              "allOf": [
                {"$ref": "#/$defs/axis"},
                {"properties": {"verification_iteration": {"maximum": 2}}}
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "approve"}}},
      "then": {
        "properties": {
          "axes": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/axis"},
                {"properties": {"verdict": {"const": "approve"}}}
              ]
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "blocked"}}},
      "then": {
        "properties": {
          "axes": {
            "contains": {
              "allOf": [
                {"$ref": "#/$defs/axis"},
                {"properties": {"verdict": {"const": "blocked"}}}
              ]
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {"properties": {"verdict": {"const": "changes-requested"}}},
      "then": {
        "properties": {
          "axes": {
            "contains": {
              "allOf": [
                {"$ref": "#/$defs/axis"},
                {"properties": {"verdict": {"const": "changes-requested"}}}
              ]
            },
            "minContains": 1,
            "not": {
              "contains": {
                "allOf": [
                  {"$ref": "#/$defs/axis"},
                  {"properties": {"verdict": {"const": "blocked"}}}
                ]
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "boundedStrings": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "string", "minLength": 1, "maxLength": 2000}
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "severity",
        "file",
        "line",
        "summary",
        "evidence",
        "recommendation"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "severity": {"enum": ["critical", "important", "minor"]},
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "^(?!/)(?!.*\\\\)(?!\\.{1,2}$)(?!\\.\\./)(?!.*\\/\\.\\.(\\/|$)).+$"
        },
        "line": {"type": ["integer", "null"], "minimum": 1},
        "summary": {"type": "string", "minLength": 1, "maxLength": 300},
        "evidence": {"type": "string", "minLength": 1, "maxLength": 4000},
        "recommendation": {"type": "string", "minLength": 1, "maxLength": 4000}
      }
    },
    "axis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "verdict", "verification_iteration", "findings"],
      "properties": {
        "axis": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*-(holistic|intent|engineering)$"
        },
        "verdict": {"enum": ["approve", "changes-requested", "blocked"]},
        "verification_iteration": {
          "type": "integer",
          "minimum": 0
        },
        "findings": {
          "type": "array",
          "maxItems": 50,
          "items": {"$ref": "#/$defs/finding"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"verdict": {"const": "approve"}}},
          "then": {
            "properties": {
              "findings": {
                "items": {
                  "allOf": [
                    {"$ref": "#/$defs/finding"},
                    {"properties": {"severity": {"const": "minor"}}}
                  ]
                }
              }
            }
          }
        }
      ]
    }
  }
}
