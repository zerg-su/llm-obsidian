{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-obsidian.local/schemas/pipeline-spec-v1.schema.json",
  "title": "Model-authored PipelineSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "spec_id", "version", "intent", "task_profile",
    "baseline_pipeline", "route_alias", "required_capabilities", "input_schema", "output_schema", "steps", "transitions", "controls",
    "budget", "completion_policy", "requested_permissions",
    "requested_side_effects", "context_pointers", "verification_checks",
    "review_mode", "human_gates", "terminal_outcomes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "spec_id": {"$ref": "#/$defs/identifier"},
    "version": {"$ref": "#/$defs/semver"},
    "intent": {"$ref": "#/$defs/identifier"},
    "task_profile": {"$ref": "#/$defs/identifier"},
    "baseline_pipeline": {"type": "string", "pattern": "^[A-Za-z0-9._:-]+/[A-Za-z0-9._:-]+$", "maxLength": 128},
    "route_alias": {"$ref": "#/$defs/identifier"},
    "required_capabilities": {"$ref": "#/$defs/identifiers"},
    "input_schema": {"$ref": "#/$defs/schemaId"},
    "output_schema": {"$ref": "#/$defs/schemaId"},
    "steps": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {"$ref": "#/$defs/step"}
    },
    "transitions": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {"$ref": "#/$defs/transition"}
    },
    "controls": {
      "type": "array", "maxItems": 2,
      "items": {"$ref": "#/$defs/control"}
    },
    "budget": {"$ref": "#/$defs/budget"},
    "completion_policy": {"enum": ["attention", "autonomous"]},
    "requested_permissions": {"$ref": "#/$defs/identifiers"},
    "requested_side_effects": {"$ref": "#/$defs/identifiers"},
    "context_pointers": {
      "type": "array", "maxItems": 8,
      "items": {"$ref": "#/$defs/contextPointer"}
    },
    "verification_checks": {
      "type": "array", "maxItems": 8,
      "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true
    },
    "review_mode": {"enum": ["simple", "deep", "full", "skip"]},
    "human_gates": {
      "type": "array", "minItems": 1,
      "contains": {"const": "initial-approval"},
      "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true
    },
    "terminal_outcomes": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true
    }
  },
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "identifiers": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "uniqueItems": true},
    "semver": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "schemaId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"},
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["step_id", "primitive_id", "primitive_version", "input_schema", "output_schema", "session_mode", "semantic_skills"],
      "properties": {
        "step_id": {"$ref": "#/$defs/identifier"},
        "primitive_id": {"$ref": "#/$defs/identifier"},
        "primitive_version": {"$ref": "#/$defs/semver"},
        "input_schema": {"$ref": "#/$defs/schemaId"},
        "output_schema": {"$ref": "#/$defs/schemaId"},
        "session_mode": {"enum": ["parent-child", "review", "verification", "worktree"]},
        "semantic_skills": {"$ref": "#/$defs/identifiers"}
      }
    },
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["primitive_id", "version"],
      "properties": {
        "primitive_id": {"$ref": "#/$defs/identifier"},
        "version": {"$ref": "#/$defs/semver"}
      }
    },
    "transition": {
      "type": "object", "additionalProperties": false,
      "required": ["from_step", "outcome", "target", "max_traversals"],
      "properties": {
        "from_step": {"$ref": "#/$defs/identifier"},
        "outcome": {"$ref": "#/$defs/identifier"},
        "target": {"type": "string", "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._:-]{0,127}|terminal:[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$"},
        "max_traversals": {"type": "integer", "minimum": 1, "maximum": 3}
      }
    },
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_limit", "model_restart_limit", "time_budget_seconds", "token_limit"],
      "properties": {
        "attempt_limit": {"type": "integer", "minimum": 1},
        "model_restart_limit": {"type": "integer", "minimum": 0},
        "time_budget_seconds": {"type": "integer", "minimum": 1},
        "token_limit": {"type": "integer", "minimum": 1}
      }
    },
    "contextPointer": {
      "type": "object", "additionalProperties": false,
      "required": ["pointer_id", "content_sha256", "byte_limit"],
      "properties": {
        "pointer_id": {"$ref": "#/$defs/identifier"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_limit": {"type": "integer", "minimum": 1}
      }
    }
  }
}
