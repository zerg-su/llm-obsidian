{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-obsidian.local/schemas/research-artifact-v2.schema.json",
  "title": "Protected research source manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "request_sha256",
    "fetched_at",
    "sources",
    "fetch_errors"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 100},
    "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fetched_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "url",
          "title",
          "content_path",
          "content_sha256",
          "source_class"
        ],
        "properties": {
          "url": {"type": "string", "format": "uri"},
          "title": {"type": "string", "minLength": 1, "maxLength": 1000},
          "content_path": {
            "type": "string",
            "pattern": "^sources/[^/]+\\.md$"
          },
          "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_class": {"enum": ["official", "internal", "third-party"]}
        }
      }
    },
    "fetch_errors": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 2000},
      "maxItems": 100
    }
  }
}
