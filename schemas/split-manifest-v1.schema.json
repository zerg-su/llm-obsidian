{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-obsidian.local/schemas/split-manifest-v1.schema.json",
  "title": "Governed SplitManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "manifest_sha256", "parent", "selection",
    "subplan_count", "max_parallel", "frozen_budget", "subplans", "join"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent": {"$ref": "#/$defs/parent"},
    "selection": {"$ref": "#/$defs/selection"},
    "subplan_count": {"type": "integer", "minimum": 1, "maximum": 32},
    "max_parallel": {"type": "integer", "minimum": 1, "maximum": 32},
    "frozen_budget": {"$ref": "#/$defs/frozenBudget"},
    "subplans": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/subplan"}
    },
    "join": {"$ref": "#/$defs/join"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "selection": {
            "properties": {"mode": {"const": "fan-out"}},
            "required": ["mode"]
          }
        }
      },
      "then": {
        "properties": {
          "selection": {
            "properties": {"reason": {"const": "fan-out"}},
            "required": ["reason"]
          },
          "subplans": {"minItems": 2}
        }
      },
      "else": {
        "properties": {
          "selection": {
            "properties": {"reason": {"not": {"const": "fan-out"}}},
            "required": ["reason"]
          },
          "subplan_count": {"const": 1},
          "max_parallel": {"const": 1},
          "subplans": {"minItems": 1, "maxItems": 1}
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "pipeline": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$"
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_sha256", "outcome_contract_sha256", "evidence_ids", "non_goals"],
      "properties": {
        "plan_sha256": {"$ref": "#/$defs/sha256"},
        "outcome_contract_sha256": {"$ref": "#/$defs/sha256"},
        "evidence_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "non_goals": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "reason"],
      "properties": {
        "mode": {"enum": ["fan-out", "one-child-fallback"]},
        "reason": {
          "enum": [
            "fan-out", "single-candidate", "independence-unproven",
            "coordination-cost", "ownership-overlap"
          ]
        }
      }
    },
    "childBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["token_limit", "time_budget_seconds"],
      "properties": {
        "token_limit": {"type": "integer", "minimum": 1},
        "time_budget_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "frozenBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subplan_limit", "max_parallel", "total_token_limit",
        "total_time_budget_seconds"
      ],
      "properties": {
        "subplan_limit": {"type": "integer", "minimum": 1, "maximum": 32},
        "max_parallel": {"type": "integer", "minimum": 1, "maximum": 32},
        "total_token_limit": {"type": "integer", "minimum": 1},
        "total_time_budget_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "subplan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subplan_id", "title", "pipeline", "route_alias", "owned_paths",
        "evidence_ids", "dependencies", "inherited_non_goals", "budget",
        "independence_proven"
      ],
      "properties": {
        "subplan_id": {"$ref": "#/$defs/identifier"},
        "title": {"type": "string", "minLength": 1},
        "pipeline": {"$ref": "#/$defs/pipeline"},
        "route_alias": {
          "allOf": [
            {"$ref": "#/$defs/identifier"},
            {"not": {"enum": ["claude", "codex"]}}
          ]
        },
        "owned_paths": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*\\\\).+$"
          }
        },
        "evidence_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "dependencies": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/identifier"}
        },
        "inherited_non_goals": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "budget": {"$ref": "#/$defs/childBudget"},
        "independence_proven": {"type": "boolean"}
      }
    },
    "join": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "required_status"],
      "properties": {
        "strategy": {"const": "manifest-order"},
        "required_status": {"const": "approved"}
      }
    }
  }
}
