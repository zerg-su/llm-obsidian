{
  "version": 1,
  "description": "Single source of truth for the UserPromptSubmit skill-router. skill_rules: regex patterns -> soft skill hints. agent_rules: same for custom sub-agents (empty in the base install).",
  "skill_rules": [
    {
      "skill": "clarify",
      "patterns": [
        "(?i)\\b/?grill[- ]?me\\b",
        "(?i)\\b(погриль|грильни|допроси)\\s+меня\\b",
        "(?i)\\b(уточни|проясни)\\b.{0,40}\\b(до кода|перед кодом|перед реализац)",
        "(?i)\\bclarify[- ]before[- ]code\\b",
        "(?i)\\b(stress[- ]test|clarify)\\b.{0,40}\\b(plan|design|before (code|implementation))\\b"
      ],
      "hint": "One question at a time; inspect codebase facts first; no plan or implementation before explicit alignment"
    },
    {
      "skill": "save",
      "patterns": [
        "(?i)\\b(сохрани|зафайл(ь|и)|зафайли|file (this|that)|save (this|that))\\b",
        "(?i)\\bзапиши (это|в вольт|в вики)\\b",
        "(?i)\\bдобавь в (вольт|вики)\\b"
      ],
      "hint": null
    },
    {
      "skill": "close",
      "patterns": [
        "(?i)\\b/close\\b",
        "(?i)\\bсохрани и (закрой|выйди|заверши)\\b",
        "(?i)\\bзаверши сесси",
        "(?i)\\bзакрой сесси",
        "(?i)\\bсейв и клоуз\\b",
        "(?i)\\bsave and (close|exit|quit)\\b",
        "(?i)\\bclose (the )?session\\b"
      ],
      "hint": "Run /save (as-is) then gracefully /exit THIS cmux surface; commit preserved by Stop hook, other sessions untouched"
    },
    {
      "skill": "dispatch",
      "patterns": [
        "(?i)\\bпараллельн(о|ую) задач(у|а)\\b",
        "(?i)\\b/?(dispatch|task[- ]?split)\\b",
        "(?i)\\bworktree\\b",
        "(?i)\\bразверни задачу\\b",
        "(?i)\\bспавн (задачу|task)\\b",
        "(?i)\\b(сделай )?диспатч\\b"
      ],
      "hint": "Short resolve only, deep work — в task-split'е"
    },
    {
      "skill": "review",
      "patterns": [
        "(?i)(?:^|\\s)/review(?:\\s|$)",
        "(?i)\\b(review|audit)\\b.{0,30}\\b(code|implementation|diff|architecture|security|spec)\\b",
        "(?i)\\b(architecture|security|spec|code|implementation) review\\b",
        "(?i)\\bcross[- ]?model review\\b",
        "(?i)\\bdeep (code )?review\\b",
        "(?i)\\bревью другой моделью\\b",
        "(?i)\\bл[её]гк\\w* ревью\\b"
      ],
      "hint": "Harness-owned simple/deep review; same-model default, cross-model only when requested"
    },
    {
      "skill": "research",
      "patterns": [
        "(?i)(?:^|\\s)/research(?:\\s|$)",
        "(?i)\\bresearch\\b.{0,30}\\b(web|sources?|current|latest|market|topic)\\b",
        "(?i)\\b(web|multi[- ]source) research\\b",
        "(?i)\\bисследуй\\b.{0,40}\\b(источник|веб|интернет)",
        "(?i)\\bпроведи исследование\\b"
      ],
      "hint": "Protected minimal-context research; unsafe full-context route remains explicit"
    },
    {
      "skill": "debug",
      "patterns": [
        "(?i)(?:^|\\s)/debug(?:\\s|$)",
        "(?i)\\bdebug\\b.{0,30}\\b(bug|failure|crash|flaky|regression|callback|behavior)\\b",
        "(?i)\\broot cause\\b",
        "(?i)\\b(диагностируй|найди причину)\\b"
      ],
      "hint": "Reproduce and diagnose first; fix only when authorized"
    },
    {
      "skill": "tdd",
      "patterns": [
        "(?i)(?:^|\\s)/tdd(?:\\s|$)",
        "(?i)\\b(implement|build|fix|develop|code|use)\\b.{0,30}\\b(with |using )?TDD\\b",
        "(?i)\\bred[- ]green[- ]refactor\\b",
        "(?i)\\bсначала (напиши )?тест\\b"
      ],
      "hint": "Approved public seam, focused red-green vertical slices"
    },
    {
      "skill": "design",
      "patterns": [
        "(?i)\\bsystem design\\b",
        "(?i)\\bdomain model(?:ing)?\\b",
        "(?i)\\b(спроектируй|архитектурн\\w* дизайн)\\b"
      ],
      "hint": "Read-only alternatives and invariants before implementation"
    },
    {
      "skill": "architecture",
      "patterns": [
        "(?i)(?:^|\\s)/architecture(?:\\s|$)",
        "(?i)^(?!.*\\b(review|audit)\\b).*\\b(project|system|whole[- ]system) architecture\\b",
        "(?i)^(?!.*\\b(ревью|аудит)\\b).*\\bспроектируй\\b.{0,30}\\bархитектур\\w*\\b.{0,30}\\b(нов\\w*|проект\\w*|систем\\w*)\\b",
        "(?i)^(?!.*\\b(ревью|аудит)\\b).*\\b(что|какие)\\b.{0,40}\\b(остал\\w*|ещ[её])\\b.{0,30}\\bархитектур\\w*\\b.{0,30}\\b(проект\\w*|систем\\w*)\\b",
        "(?i)^(?!.*\\b(ревью|аудит)\\b).*\\b(продолжим|продолжи)\\b.{0,20}\\bпроектир\\w*\\b.{0,30}\\b(проект\\w*|систем\\w*)\\b"
      ],
      "hint": "Resolve the exact project, map its artifact graph, and advance one bounded Design Frontier concern"
    },
    {
      "skill": "codebase-design",
      "patterns": [
        "(?i)\\b(codebase|module) design\\b",
        "(?i)\\b(deep module|module boundar(?:y|ies)|test seam)\\b",
        "(?i)\\b(refactor|extract|split)\\b.{0,45}\\b(oversized|tangled|monolith|orchestrator|module)\\b",
        "(?i)\\b(границ\\w* модул|глубок\\w* модул|разбить|выделить)\\b.{0,45}\\b(код|модул|оркестратор|монолит)\\b"
      ],
      "hint": "Read-only deep-module boundaries, durable interfaces, and owned test seams"
    },
    {
      "skill": "implementation-plan",
      "patterns": [
        "(?i)\\bimplementation plan\\b.{0,50}\\b(files?|ownership|slices?|interfaces?|consumes|produces|tdd)\\b",
        "(?i)\\b(plan|break down)\\b.{0,40}\\b(vertical slices?|file ownership|consumes|produces)\\b",
        "(?i)\\bплан реализац\\w*\\b.{0,50}\\b(файл\\w*|ответственност\\w*|слайс\\w*|интерфейс\\w*|тест\\w*)\\b"
      ],
      "hint": "Read-only file ownership and consumes/produces TDD slices bound to outcome evidence"
    },
    {
      "skill": "decompose",
      "patterns": [
        "(?i)(?:^|\\s)/decompose(?:\\s|$)",
        "(?i)^(?!.*\\b(functions?|helpers?|files?|modules?)\\b).*\\b(decompose|break down)\\b.{0,80}\\b(architecture|project|delivery|work items?|work graph)\\b",
        "(?i)\\b(map|build|revise)\\b.{0,40}\\b(accepted project|project (spec|contract|architecture))\\b.{0,50}\\b(work item|work graph|delivery)\\b",
        "(?i)^(?!.*\\b(файл|функц|модул)\\w*\\b).*\\b(принят\\w*\\s+архитектур\\w*|проектн\\w*\\s+(spec|contract))\\b.{0,60}\\b(разбей|декомпозир\\w*|work items?)\\b",
        "(?i)^(?!.*\\b(файл|функц|модул)\\w*\\b).*\\b(разбей|декомпозир\\w*)\\b.{0,60}\\b(доставк\\w*|work items?|проектн\\w* (архитектур|знани))\\b"
      ],
      "hint": "Map accepted project knowledge into a Work Item DAG; ACCEPT is zero-effect and MATERIALIZE needs separate authorization"
    },
    {
      "skill": "prototype",
      "patterns": [
        "(?i)(?:^|\\s)/prototype(?:\\s|$)",
        "(?i)\\b(build|create|make|test|try)\\b.{0,30}\\b(prototype|proof of concept)\\b",
        "(?i)\\b(сделай|создай|проверь)\\b.{0,30}\\bпрототип\\b",
        "(?i)\\bтехнический спайк\\b"
      ],
      "hint": "One question in a disposable harness-owned worktree"
    },
    {
      "skill": "resolve-conflict",
      "patterns": [
        "(?i)\\bresolve (the )?(merge|rebase|git) conflict",
        "(?i)\\bконфликт\\w* (merge|rebase|git|слияни)",
        "(?i)\\b/?resolve[- ]?conflict\\b"
      ],
      "hint": "Exact conflicted worktree; no stage/continue/abort without authorization"
    },
    {
      "skill": "wiki-query",
      "patterns": [
        "(?i)\\bчто (ты )?знаешь про\\b",
        "(?i)\\bquery:\\b",
        "(?i)\\bпоищи в вики\\b",
        "(?i)\\bпосмотри в вольт\\b"
      ],
      "hint": null
    },
    {
      "skill": "find-session",
      "patterns": [
        "(?i)\\bнайди\\s+похож\\w*\\s+сесси\\w*\\b",
        "(?i)\\bбыло\\s+(ли\\s+)?подобн\\w*\\b",
        "(?i)\\b(прошл|похож)\\w*\\s+сесси\\w*\\b",
        "(?i)\\bsimilar past (task|session)\\b",
        "(?i)\\b/?find[- ]?session\\b",
        "(?i)\\bcontext from earlier\\b",
        "(?i)\\bearlier sessions?\\b",
        "(?i)\\b(контекст из )?прошл\\w+ сесси\\w*\\b"
      ],
      "hint": "Boring retrieval: wiki sessions: + history.jsonl + session-to-pages.jsonl"
    },
    {
      "skill": "draft",
      "patterns": [
        "(?i)\\bсформируй\\s+(\\d+\\s+вариант\\w*\\s+)?ответ\\w*\\b",
        "(?i)\\bкак\\s+(можно\\s+)?ответить\\b",
        "(?i)\\bdraft\\s+(a |the )?(reply|comment|response|answer|message|note|ответ|комментарий)\\b",
        "(?i)\\bпомоги\\s+(ответить|написать ответ)\\b",
        "(?i)\\b(сформируй|подготовь)\\s+\\d*\\s*(вариант\\w*\\s+)?(ответ\\w*|коммент\\w*)\\b"
      ],
      "hint": "Communication ADVISOR — 2-3 варианта drafts + историч-штрихи; user пушит сам"
    },
    {
      "skill": "daily",
      "patterns": [
        "(?i)\\bстатус за день\\b",
        "(?i)\\bстатус для трекера\\b",
        "(?i)\\bdaily status\\b"
      ],
      "hint": null
    },
    {
      "skill": "journal",
      "patterns": [
        "(?i)\\b/?journal\\b",
        "(?i)\\bдневник\\b",
        "(?i)\\bоткрой\\s+(сегодняшний\\s+)?дневник\\b",
        "(?i)\\bплан\\s+на\\s+(сегодня|завтра|послезавтра|понедельник|вторник|сред[уы]|четверг|пятниц[уы]|суббот[уы]|воскресенье|\\d)",
        "(?i)\\bзапиши\\s+на\\s+(завтра|послезавтра|\\d|понедельник|вторник|среду|четверг|пятницу|субботу|воскресенье)",
        "(?i)\\bнапомни\\s+(в|на)\\s+\\S",
        "(?i)\\bперенеси\\s+невыполненное\\b",
        "(?i)\\bотметь\\b.{1,40}\\bсделанн",
        "(?i)\\bjournal\\s+(plan|remind|today|check|sessions)\\b",
        "(?i)\\b(plan|remind)\\s+(for\\s+)?(tomorrow|today)\\b",
        "(?i)\\bcarry\\s*over\\b",
        "(?i)\\bкарт\\w*\\s+сесси\\w*\\b",
        "(?i)\\bкакие\\s+сесси\\w*\\b.{0,20}\\bсегодня\\b"
      ],
      "hint": "Date-keyed journal wiki/daily/ (Планы/Напоминания/Инциденты/Сделано). Modes: today/plan/remind/check. Dateless 'remind me to' → /backlog; ситуативное 'что сегодня' → /morning; EOD-статус → /daily"
    },
    {
      "skill": "agenda",
      "patterns": [
        "(?i)\\b/?agenda\\b",
        "(?i)\\bagenda\\s+(scan|collect|report)\\b",
        "(?i)\\bсобер\\w*\\s+незаверш\\w*\\b",
        "(?i)\\bперенеси\\s+(планы|напоминания|незаверш[её]нное)\\b",
        "(?i)\\b(месячн\\w*|за месяц)\\b.{0,30}\\b(незаверш|план|напомин)\\w*\\b",
        "(?i)\\bпроверь\\b.{0,40}\\b(стар\\w*|прошл\\w*)\\b.{0,40}\\b(план|напомин)\\w*\\b"
      ],
      "hint": "Read-only scan first; atomic collect marks sources [>], creates one target occurrence, and refreshes the monthly live Tasks report"
    },
    {
      "skill": "backlog",
      "patterns": [
        "(?i)\\bне\\s+забы(ть|вать|л)\\b",
        "(?i)\\bхочу\\s+запомнить\\b",
        "(?i)\\bв\\s+TODO[:\\s]",
        "(?i)\\bбэклог\\b",
        "(?i)\\bbacklog\\b",
        "(?i)\\bremind me to\\b",
        "(?i)\\bбыло бы хорошо\\b"
      ],
      "hint": "Single file wiki/backlog.md, append-only. Modes: add/list/promote. Promote chains into /save (wiki goal/question) or drop"
    },
    {
      "skill": "wiki-ingest",
      "patterns": [
        "(?i)\\bingest (this|section|<|/)\\b",
        "(?i)\\bзагрузи (источник|это в вики)\\b",
        "(?i)\\bобработай (этот|это) (файл|источник)\\b",
        "(?i)\\bразбери и зафайль\\b",
        "(?i)\\b(обработай|разбери|загрузи|закинь|импортируй)\\b.{0,80}\\.(pdf|docx|pptx|xlsx|odt|ods|odp|epub|md|txt|html?)\\b",
        "(?i)\\bingest\\b.{0,80}\\.(pdf|docx|pptx|xlsx|odt|ods|odp|epub|md|txt|html?)\\b"
      ],
      "hint": "Local binary documents normalize through pinned offline Docling; text-like files use the stdlib fast path"
    },
    {
      "skill": "learn",
      "patterns": [
        "(?i)\\b/learn\\b",
        "(?i)\\bучимся\\b",
        "(?i)\\bдавай (по)?учиться\\b",
        "(?i)\\bквиз(?:а|ы)? по\\b",
        "(?i)\\bпроверь меня\\b",
        "(?i)\\bпрогресс обучени",
        "(?i)\\bquiz me\\b",
        "(?i)\\bstudy module\\b",
        "(?i)\\bмодул[ьея] [AB]\\d\\b"
      ],
      "hint": "Интерактивный тьютор AI Architect Curriculum (wiki/learning/): study/quiz/practice/progress"
    },
    {
      "skill": "distill-runbook",
      "patterns": [
        "(?i)\\b/?distill[- ]?runbook\\b",
        "(?i)\\bранбук из (сессии|команд)\\b",
        "(?i)\\bсделай ранбук из\\b",
        "(?i)\\bдистиллируй ранбук\\b",
        "(?i)\\bсохрани команды сессии\\b",
        "(?i)\\brunbook from (this )?session\\b",
        "(?i)\\bsave session commands\\b"
      ],
      "hint": "Session command-log → human-executable runbook (AI-outage resilience). Шум фильтруется, гочи из failed команд"
    }
  ],
  "agent_rules": []
}
